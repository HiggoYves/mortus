{
  "name": "mortus",
  "version": "0.4.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "test-env:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-migration-test.ps1",
    "test-env:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-migration-test.ps1",
    "test-env:discard": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/discard-migration-test-db.ps1"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "18.0.9",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "better-sqlite3": "12.11.1",
    "prisma": "7.10.1",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true
  }
}
